{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/sensei", "destination": "/teacher" },
    { "source": "/kyoushi", "destination": "/teacher" },
    { "source": "/qr", "destination": "/qr" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [ { "key": "Cache-Control", "value": "no-cache" } ] }
  ]
}
